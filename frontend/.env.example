# =============================================================================
# iGOT AI Hub — Environment Variables Template
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase Configuration (Required for authenticated mode)
# ---------------------------------------------------------------------------
# Your Supabase project URL, e.g. https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase anon/public key (safe for the browser — NOT the service-role key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------------
# Official iGOT Live API (NOT YET AVAILABLE — Future Integration Boundary)
# ---------------------------------------------------------------------------
# These environment variables define the architectural boundary for authorized
# iGOT Karmayogi API access. They are intentionally left blank because no
# official live endpoint, OAuth credentials, or signed authorization has been
# provided to this project.
#
# When authorized institutional integration becomes available, set these
# values and the OfficialIGOTAdapter will activate automatically.
#
# VITE_IGOT_OFFICIAL_API_URL=
# VITE_IGOT_OFFICIAL_API_KEY=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - If Supabase variables are not set, the application runs in demo/mock mode.
# - Demo mode uses localStorage and requires no database connection.
# - The service-role (admin) key must NEVER be placed in the frontend.
